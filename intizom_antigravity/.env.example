BOT_TOKEN=your_botfather_token_here
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key
CAMERA_WEBAPP_URL=https://your-domain.com/camera-live-view
# Telegram Mini App dashboard (miniapp/ papkasi statik hostingga
# joylashtirilgach shu yerga uning URL'ini kiriting; bo'sh qoldirilsa
# "🌐 Dashboard" tugmasi menyuda ko'rinmaydi)
DASHBOARD_WEBAPP_URL=

# TZ 4.1 — bonus formulasi sozlamalari (hardcode emas, kerak bo'lsa o'zgartiring)
BONUS_MAX_PERCENT=0.10
MONTHLY_CONVERSATION_NORM=20

# TZ 15-bo'lim — ko'p-sohali konfiguratsiya. Bo'sh qoldirilsa, standart
# "xususiy_ofis" mezonlari ishlatiladi. onboard_new_client.py buni avtomatik
# to'ldiradi (clients/<CLIENT_ID>/criteria.json fayli o'qiladi).
CLIENT_ID=
INDUSTRY=

# TZ 19-bo'lim — uch kompyuterli tarmoq arxitekturasi. recorder.py va
# bot.py BIR XIL jismoniy papkani ko'rsatishi kerak, lekin har bir
# kompyuterdan turlicha manzil bilan:
#   - SERVER kompyuterida (bot.py ishlaydigan): papkaning O'ZINI ulashtirgan
#     lokal manzil, masalan: C:\darcha_bot\recordings
#   - XODIM kompyuterlarida (recorder.py ishlaydigan): serverdagi shu
#     papkaga TARMOQ orqali murojaat, masalan: \\SERVER-PC\recordings
#     yoki tarmoq diski sifatida ulangan bo'lsa: Z:\recordings
RECORDINGS_DIR=./recordings

# TZ 22.3-band — ish soatlari oynasi (ixtiyoriy). Bo'sh qoldirilsa,
# recorder.py cheklovsiz (24/7) ishlaydi. Belgilansa, shu oraliqdan
# tashqarida mikrofon VAD'ni o'chiradi (maxfiylik va resurs tejash).
# FAQAT xodim kompyuterlaridagi recorder.py uchun tegishli.
WORK_HOURS_START=
WORK_HOURS_END=
