<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.shield.parentalguard">

    <!-- 1. Tarmoq va aloqa ruxsatlari -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 2. Bildirishnoma va Foreground xizmati.
         TUR "location", "dataSync" emas: Android 15+ da dataSync turidagi
         xizmat sutkada atigi 6 soat ishlay oladi, so'ng tizim onTimeout()
         chaqiradi va to'xtatilmasa ilovani HALOKATLI xato bilan yiqitadi
         (RemoteServiceException). Bizning xizmatimiz aslida joylashuv
         kuzatuvi uchun ishlaydi — "location" turi ham haqiqatga mos, ham
         vaqt chegarasiga tushmaydi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 3. Qurilmadan foydalanish tahlili (UsageStats) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 4. Joylashuv ruxsatlari.
         ACCESS_BACKGROUND_LOCATION shart: usiz Android 10+ da ilova fonda
         joylashuvni umuman o'qiy olmaydi, ya'ni radar telefon qulflangan
         holda ishlamaydi — mahsulotning asosiy va'dasi bajarilmaydi.
         Bu ruxsat Play Console'da alohida deklaratsiya talab qiladi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 5. Tizim qayta yonganda tiklanish -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ParentalGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParentalGuard">

        <!-- Asosiy Juftlash va Ruxsatlar Oynasi (Pairing Activity) -->
        <!-- Kirish ekrani — ilova shu yerdan boshlanadi. -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParentalGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Asosiy ekran: Mini App bilan bir xil interfeys. -->
        <activity
            android:name=".ui.AppWebActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParentalGuard" />

        <!-- "Poyga" o'yinining NATIVE sinov ekrani — hozircha faqat ichki
             ko'rib chiqish uchun, hali asosiy menyuga ulanmagan
             (games/NativeRaceActivity.kt'dagi izohga qarang). -->
        <activity
            android:name=".games.NativeRaceActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ParentalGuard" />

        <activity
            android:name=".PairingActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParentalGuard">
            <!-- Ilova endi kirish ekranidan boshlanadi, shuning uchun bu
                 yerda LAUNCHER yo'q: aks holda telefonda ikkita belgi
                 paydo bo'lardi. -->
            <!-- Custom scheme: shield://pair?code=XXXXXXXX (8-char device pairCode) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shield" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Shaffof va O'ldirilmas Foreground Servis -->
        <service
            android:name=".services.PersistentGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Boot Completed Receiver (Qurilma o'chib yonganda qayta ishga tushirish) -->
        <receiver
            android:name=".receivers.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
